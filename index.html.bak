import { useState, useEffect, useCallback, useRef } from "react";

// ─────────────────────────────────────────
// CONSTANTS
// ─────────────────────────────────────────
const USERS_KEY = "shadow-system-users";
const SESSION_KEY = "shadow-system-session";
const STORAGE_KEY = (uid) => `shadow-system-state-${uid}`;

const RANKS = ["E", "D", "C", "B", "A", "S", "National"];
const RANK_COLORS = { E: "#aaaaaa", D: "#4CAF50", C: "#2196F3", B: "#9C27B0", A: "#FF9800", S: "#FFD700", National:
"#ff2244" };
const TITLES = { E: "Weakest Hunter", D: "Novice Hunter", C: "Capable Hunter", B: "Elite Hunter", A: "Master Hunter", S:
"Shadow Sovereign", National: "Monarch of Shadows" };
const DUNGEONS = [
{ rank: "E", boss: "Goblin Shaman", emoji: "👺", blocksNeeded: 3 },
{ rank: "D", boss: "Orc Warlord", emoji: "🗡️", blocksNeeded: 4 },
{ rank: "C", boss: "Stone Golem", emoji: "🪨", blocksNeeded: 5 },
{ rank: "B", boss: "Iron Overlord", emoji: "👹", blocksNeeded: 6 },
{ rank: "A", boss: "Shadow Monarch", emoji: "💀", blocksNeeded: 8 },
];

